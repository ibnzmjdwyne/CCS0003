#include <iostream>
#include <iomanip>
using namespace std;

int main()
{
    //input
    double meal_price, service_charge;
    int quantity;
    float nofstud;
    
    //result
    cout << "Enter Meal Price: ";
    cin >> meal_price;
    cout << "Enter the Quantity: ";
    cin >> quantity;
    cout << "Enter Service-Charge Percentage: ";
    cin >> service_charge;
    cout << "Enter the number of students for sharing: ";
    cin>> nofstud;
    
    // process
    double subtotal=meal_price*quantity;
    double service_sc = subtotal*service_charge/100;
    double finalbill= subtotal + service_sc;
    float share_student = finalbill/nofstud;
    
    cout << fixed << setprecision(2);
    
    cout<< "\n*******Student Receipt*******"<< endl;
    cout<< "Subtotal = "<< subtotal << endl;
    cout<< "Service Charge =" <<service_sc << endl;
    cout<< "Final Bill = " << finalbill << endl;
    cout << "Share/student = " << share_student << endl;
    
    return 0;
}
