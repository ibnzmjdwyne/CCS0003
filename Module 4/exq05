Exercise Q05 - Conference Seating Planner  

*******************************************************************************/
#include <iostream>
#include <iomanip>
#include <math.h>
using namespace std;

int main()
{
   // input
   int attendees, seat_table;
   int tablereq, total_seats, unused;
  
   //result
   cout << "Enter the number of attendees: ";
   cin >> attendees;
   cout << "Enter the seats per table: ";
   cin >> seat_table;
   
   // process
  double etablereq = static_cast<double>(attendees)/seat_table;
  tablereq = ceil(etablereq);
  total_seats = tablereq* seat_table;
  unused = total_seats - attendees;
  
  cout << fixed << setprecision(2);
  
  cout << "\n******Conference Seating Planner******";
  cout << "\nExact tables = " << etablereq << ";";
  cout << "\nTables required = " << tablereq << "; ";
  cout << "\nTotal seats = " << total_seats << ";";
  cout << "\nUnused seats = " << unused;
  
    return 0;
}
