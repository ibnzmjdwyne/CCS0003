Exercise Q08 - Environmental Sensor Summary 

*******************************************************************************/
#include <iostream>
#include <iomanip>
#include <math.h>
using namespace std;

int main()
{
   // input
   double t1, t2, t3;
   double average, absolute_difference;
   
   // result
   cout << "Enter three decimal temperature readings: ";
   cin >> t1 >> t2 >> t3;
   
  // process
   average = (t1+t2+t3)/3;
   absolute_difference = fabs(t1 - t3);
   
   cout << fixed << setprecision(3);
   
   cout << "\n****Environmental Sensor Summary****"<< endl;
   cout << "Average = " << average << ";" << endl;
   cout << "|T1 - T3| = " << absolute_difference << ";" << endl;
   cout << "Floor =" << (int)floor(average) << ";" << endl;
   cout << "Ceil = " << (int)ceil(average) << ";" << endl;
   cout << "Trunc = " << (int)trunc(average) << ";" << endl;
   cout << "Round = " << (int)round (average) << ";" << endl;
  

    return 0;
}
